{
  "name": "Color Coder",
  "description": "Extention automates color identification, assembly, and export of your color palette.",
  "version": "1.0.0.1",
  "manifest_version": 3,
  "action": {
    "default_title": "Color Coder"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "sidePanel"
  ]
}