{
  "name": "Palette Builder",
  "description": "Automate your color identification and palette assembly!",
  "version": "1.1.1",
  "manifest_version": 3,
  "action": {
    "default_title": "Palette Builder"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "sidePanel"
  ]
}